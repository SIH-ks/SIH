# Copy to .env and fill in. Credentials resolve via the Anthropic SDK's normal
# chain (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or `ant auth login`) -- this file
# never holds a key directly; only engine tuning knobs live here.

ADHIKAR_LLM_MODEL=claude-opus-5
ADHIKAR_LLM_EFFORT=high
ADHIKAR_LLM_ENABLE_PROMPT_CACHING=true
ADHIKAR_LLM_CACHE_TTL=1h

ADHIKAR_RENDER_DPI=300
ADHIKAR_OCR_LANGUAGES=["hi","en"]
ADHIKAR_TESSERACT_LANGUAGES=hin+eng
# Windows: ADHIKAR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

ADHIKAR_VALIDATION_POLICY_PATH=policies/validation_policy.yaml

# Set only for a single-state deployment where every bare bigha figure should
# resolve against one region. Leave unset to require unit words on every bigha cell.
# ADHIKAR_DEFAULT_BIGHA_REGION=up_pucca

ADHIKAR_GEOMETRY_SEVERE_THRESHOLD=0.10
ADHIKAR_GEOMETRY_SURVEY_TOLERANCE=0.005
