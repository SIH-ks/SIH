# Copy to .env and fill in. Neither provider's key is ever read from this file by
# adhikar itself -- both SDKs resolve credentials from their own environment
# variable independently, and this file only holds engine tuning knobs.

# -- Provider selection -------------------------------------------------------------
# "groq"      (default): free tier, no billing setup. Get a key at
#              https://console.groq.com/keys and set it as GROQ_API_KEY below.
# "anthropic": strict tool-use extraction, materially stronger on dense
#              multilingual tables. Needs ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN,
#              or `ant auth login` -- see adhikar/llm/extractor.py.
ADHIKAR_LLM_PROVIDER=groq

# -- Groq (used when ADHIKAR_LLM_PROVIDER=groq) --------------------------------------
GROQ_API_KEY=
ADHIKAR_GROQ_MODEL=qwen/qwen3.8-27b
ADHIKAR_GROQ_MAX_COMPLETION_TOKENS=8000
ADHIKAR_GROQ_MAX_JSON_REPAIR_ATTEMPTS=2

# -- Anthropic (used when ADHIKAR_LLM_PROVIDER=anthropic) ----------------------------
ANTHROPIC_API_KEY=
ADHIKAR_LLM_MODEL=claude-opus-5
ADHIKAR_LLM_EFFORT=high
ADHIKAR_LLM_ENABLE_PROMPT_CACHING=true
ADHIKAR_LLM_CACHE_TTL=1h

# -- OCR / rasterisation --------------------------------------------------------------
ADHIKAR_RENDER_DPI=300
ADHIKAR_OCR_LANGUAGES=["hi","en"]
ADHIKAR_TESSERACT_LANGUAGES=hin+eng
# Windows: ADHIKAR_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

ADHIKAR_VALIDATION_POLICY_PATH=policies/validation_policy.yaml

# Set only for a single-state deployment where every bare bigha figure should
# resolve against one region. Leave unset to require unit words on every bigha cell.
# ADHIKAR_DEFAULT_BIGHA_REGION=up_pucca

ADHIKAR_GEOMETRY_SEVERE_THRESHOLD=0.10
ADHIKAR_GEOMETRY_SURVEY_TOLERANCE=0.005
