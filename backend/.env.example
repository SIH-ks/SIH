# =============================================================================
# Adhikar backend — environment
# Copy to `.env`. Every value here is a default the code already carries; this
# file exists to show what is tunable, not to be required.
# =============================================================================

ADHIKAR_API_ENVIRONMENT=development

# --- Database -----------------------------------------------------------------
# Leave unset for the bundled SQLite file (zero setup, no Docker). Point at
# Postgres/PostGIS for a real deployment — the ORM models are portable between
# the two, see app/models/record.py.
# ADHIKAR_API_DATABASE_URL=postgresql+psycopg://adhikar:adhikar@localhost:5432/adhikar

# If the configured database is unreachable at boot, fall back to SQLite rather
# than refusing to start. Loud, never silent (see /health). Turn this off for any
# deployment where the wrong database is worse than no database.
ADHIKAR_API_DATABASE_FALLBACK_TO_SQLITE=true

ADHIKAR_API_REDIS_URL=redis://localhost:6379/0

# --- Auth ---------------------------------------------------------------------
ADHIKAR_API_JWT_SECRET=change-me-in-production
ADHIKAR_API_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Enforce JWT + RBAC on every endpoint except /health, /auth/login and the docs.
ADHIKAR_API_REQUIRE_AUTH=true

# Create the four demo accounts (collector / tehsildar / operator / auditor) on
# first boot if they are missing. TURN THIS OFF FOR ANY REAL DEPLOYMENT.
ADHIKAR_API_SEED_DEMO_USERS=true
ADHIKAR_API_DEMO_USER_PASSWORD=adhikar@2026

# --- Storage ------------------------------------------------------------------
ADHIKAR_API_OBJECT_STORAGE_BUCKET=adhikar-scans
# ADHIKAR_API_OBJECT_STORAGE_ENDPOINT=http://localhost:9000  # MinIO
ADHIKAR_API_MAX_UPLOAD_SIZE_MB=25
ADHIKAR_API_MAX_BATCH_UPLOAD_FILES=25

ADHIKAR_API_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Service levels -----------------------------------------------------------
# Hours a parcel may sit in the queue per triage band before it counts as an SLA
# breach. Negotiated per district office, which is why it is configuration.
ADHIKAR_API_SLA_HOURS_BY_PRIORITY={"critical":24,"high":72,"normal":168,"low":336}

# Manual keying + cross-check minutes displaced by one auto-validated record.
# A department-supplied assumption, returned by the API alongside the figure it
# derives so the number is never quoted without it.
ADHIKAR_API_MINUTES_SAVED_PER_RECORD=22

# Also copy ai-engine/.env.example -> ai-engine/.env for the pipeline's own settings
# (LLM model/effort, OCR languages, validation policy path). ANTHROPIC_API_KEY
# resolves independently via the Anthropic SDK's standard credential chain.
