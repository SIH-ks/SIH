# Base URL of the Adhikar FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Demo fallback. When the backend is unreachable (or another service is answering
# on that port), read paths serve bundled fixtures from src/lib/demoData.ts so the
# console is demoable standalone. Anything served this way is marked "DEMO DATA" in
# the header. Set to "false" to disable and surface the connection error instead.
NEXT_PUBLIC_ALLOW_DEMO_DATA=true
