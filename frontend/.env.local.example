# Base URL of the Adhikar FastAPI backend. The console derives the static-file
# origin from this too (see src/lib/api-config.ts), so there is deliberately no
# second variable that could drift out of sync with it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Notes on what is NOT configured here:
#
# * There is no auth secret. The session JWT is issued by the backend and stored
#   in an httpOnly cookie by /api/session; the browser bundle never sees it.
# * There is no demo-data flag. The backend runs with zero setup (SQLite, four
#   auto-provisioned accounts) and `python scripts/seed_demo_data.py --reset`
#   populates it, so a client-side fixture fallback would only ever be a second,
#   quietly divergent copy of the same data.
